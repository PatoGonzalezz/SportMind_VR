---
import "../../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-sportmind.png" />
    <title>Cambiar contraseña | SportMind</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-slate-100 p-4 text-slate-900 antialiased">
   <main class="flex-1 flex flex-col items-center justify-center w-full max-w-2xl mx-auto px-4 pt-12 pb-24">
  
  <div class="text-center mb-10">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-tr from-teal-500 to-teal-700 text-white mb-6 shadow-lg shadow-teal-500/30">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
      </svg>
    </div>
    <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight mb-3">Seguridad de la Cuenta</h1>
    <p class="text-slate-500 text-lg max-w-md mx-auto">Actualiza tu clave de acceso para mantener tu información clínica protegida.</p>
  </div>

  
  <div class="w-full bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden">
    <div class="p-8 sm:p-12">
      <form id="passForm" class="space-y-8">
        
      
        <div>
          <label for="email" class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">Correo electrónico</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <input
              type="email"
              id="email"
              required
              autocomplete="email"
              placeholder="correo@sportmind.com"
              value="pat.gonzalezg@duocuc.cl" 
              class="block w-full pl-12 pr-4 py-4 border-2 border-slate-100 rounded-xl bg-slate-50 text-slate-500 sm:text-base focus:outline-none transition-colors"
            />
          </div>
        </div>

       
        <div>
          <label for="password" class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">Nueva contraseña</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <input
              type="password"
              id="password" 
              required
              placeholder="Ingresa tu nueva contraseña segura"
              class="block w-full pl-12 pr-12 py-4 border-2 border-slate-200 rounded-xl focus:ring-4 focus:ring-teal-500/20 focus:border-teal-500 bg-white sm:text-base transition-all duration-200 text-slate-800 placeholder-slate-400 outline-none"
            />
            <div class="absolute inset-y-0 right-0 pr-4 flex items-center cursor-pointer hover:bg-slate-50 rounded-r-xl transition-colors">
              <svg class="h-6 w-6 text-slate-400 hover:text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </div>
          </div>
        </div>

        
        <button
          type="submit"
          id="btnSubmit"
          class="w-full flex justify-center items-center py-4 px-6 rounded-xl shadow-lg shadow-teal-600/30 text-base font-bold text-white bg-gradient-to-r from-teal-500 to-teal-700 hover:from-teal-600 hover:to-teal-800 focus:outline-none focus:ring-4 focus:ring-teal-500/50 transition-all duration-300 transform hover:-translate-y-1"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          Actualizar credenciales
        </button>
      </form>

      
      <div id="msg" role="status" aria-live="polite" class="hidden mt-6 text-center text-sm font-medium"></div>

      
      <p class="mt-6 text-center text-sm text-slate-500">
        <a href="/login" class="font-semibold text-teal-600 underline-offset-4 hover:text-teal-700 hover:underline transition-colors">volver al inicio de sesión</a>
      </p>

    </div>
    
    
    <div class="bg-slate-50 px-8 py-6 border-t border-slate-100 flex items-center justify-center">
        <p class="text-sm text-slate-500 text-center flex items-center gap-2 font-medium">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            Conexión segura cifrada de extremo a extremo
        </p>
    </div>
  </div>
</main>
    <script>
      const form = document.getElementById("passForm") as HTMLFormElement;
      const emailInput = document.getElementById("email") as HTMLInputElement;
      const passInput = document.getElementById("newPassword") as HTMLInputElement;
      const btnSubmit = document.getElementById("btnSubmit") as HTMLButtonElement;
      const btnToggle = document.getElementById("btnToggle") as HTMLButtonElement;
      const eyeSlash = document.getElementById("eyeSlash") as unknown as SVGElement;
      const msg = document.getElementById("msg") as HTMLElement;

      const MSG_BASE = "mt-4 rounded-xl border px-3.5 py-3 text-center text-sm font-medium";
      const MSG_TONE = {
        success: "border-emerald-200 bg-emerald-50 text-emerald-700",
        error: "border-red-200 bg-red-50 text-red-700",
        loading: "border-blue-200 bg-blue-50 text-blue-700",
      };
      const BTN_LABEL = btnSubmit.textContent?.trim() || "Actualizar contraseña";

      function showMsg(text: string, type: "success" | "error" | "loading") {
        msg.textContent = text;
        msg.className = `${MSG_BASE} ${MSG_TONE[type]}`;
      }

      btnToggle.addEventListener("click", () => {
        const show = passInput.type === "password";
        passInput.type = show ? "text" : "password";
        eyeSlash.classList.toggle("hidden", !show);
        btnToggle.setAttribute("aria-pressed", String(show));
        btnToggle.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        showMsg("Actualizando…", "loading");
        btnSubmit.disabled = true;
        btnSubmit.textContent = "Actualizando…";

        try {
          const res = await fetch("/api/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action: "changePassword",
              email: emailInput.value.trim(),
              newPassword: passInput.value,
            }),
          });

          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || "No se pudo actualizar.");

          showMsg("¡Contraseña actualizada con éxito!", "success");
          form.reset();
        } catch (err: any) {
          showMsg(err.message || "Error al procesar la solicitud.", "error");
        } finally {
          btnSubmit.disabled = false;
          btnSubmit.textContent = BTN_LABEL;
        }
      });
    </script>
  </body>
</html>