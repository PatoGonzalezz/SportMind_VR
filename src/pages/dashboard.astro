---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- ── ENCABEZADO ── -->
  <header
    class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
  >
    <div class="max-w-2xl">
      <h1
        class="text-[1.65rem] font-extrabold tracking-tight text-slate-900 sm:text-3xl"
      >
        Evaluaciones de atletas
      </h1>
      <p class="mt-1.5 text-sm leading-relaxed text-slate-500">
        Revisa el rendimiento emocional y físico de cada sesión registrada.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <!-- Botón de vincular para especialistas (oculto por defecto para administradores) -->
      <button
        type="button"
        id="btn-abrir-modal-vincular"
        class="specialist-only hidden inline-flex h-10 items-center gap-2 rounded-xl bg-indigo-600 px-4 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2"
      >
        <svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true">
          <path
            d="M10 4v12M4 10h12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        Vincular sesión
      </button>

      <a
        href="/especialista/crear"
        id="btn-crear-entrenador"
        class="admin-only inline-flex h-10 items-center gap-2 rounded-xl bg-blue-600 px-4 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
      >
        <svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true">
          <path
            d="M10 4v12M4 10h12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        Crear entrenador
      </a>

      <p
        class="inline-flex h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 text-sm font-medium text-slate-600 shadow-sm"
      >
        <span
          class="size-2 rounded-full bg-emerald-500 ring-4 ring-emerald-500/20"
          aria-hidden="true"></span>
        <span id="sources-count" aria-live="polite">Conectando…</span>
      </p>
    </div>
  </header>

  <!-- ── RESUMEN (KPIs) ── -->
  <section
    id="kpis-section"
    class="mb-6 rounded-2xl bg-slate-900 p-6 text-white shadow-[0_12px_32px_-16px_rgba(15,23,42,0.5)] sm:p-8"
    aria-label="Resumen de evaluaciones filtradas"
  >
    <h2 class="text-2xl font-extrabold tracking-tight text-slate-50">
      Administración clínica SportMind
    </h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-400">
      Gestiona los reportes automatizados y la telemetría de las gafas VR.
    </p>
    <dl
      class="mt-6 grid max-w-md grid-cols-2 divide-x divide-white/10 border-t border-white/10"
    >
      <div class="py-4 pr-5 sm:py-5">
        <dt class="text-[13px] font-medium text-slate-400">Atletas activos</dt>
        <dd
          id="kpi-unique-athletes"
          class="mt-1 text-3xl font-extrabold tabular-nums text-slate-50"
        >
          —
        </dd>
      </div>
      <div class="py-4 pl-5 sm:py-5 sm:pl-8">
        <dt class="text-[13px] font-medium text-slate-400">Sesiones totales</dt>
        <dd
          id="kpi-total-sessions"
          class="mt-1 text-3xl font-extrabold tabular-nums text-slate-50"
        >
          —
        </dd>
      </div>
    </dl>
  </section>

  <!-- ── BARRA DE HERRAMIENTAS ── -->
  <section
    class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5"
    aria-label="Búsqueda, filtros y vistas"
  >
    <div class="flex flex-col gap-3 sm:flex-row">
      <div class="relative min-w-0 flex-1">
        <label for="search-input" class="sr-only">Buscar evaluaciones</label>
        <svg
          viewBox="0 0 20 20"
          fill="none"
          class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-slate-400"
          aria-hidden="true"
        >
          <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.8"
          ></circle>
          <path
            d="M13.5 13.5L17 17"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
        <input
          type="text"
          id="search-input"
          placeholder="Buscar por nombre, deporte o emoción…"
          autocomplete="off"
          class="block w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-10 text-sm text-slate-900 transition placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-100"
        />
        <button
          type="button"
          id="btn-clear-search"
          style="display:none;"
          aria-label="Limpiar búsqueda"
          class="absolute right-2 top-1/2 size-7 -translate-y-1/2 cursor-pointer rounded-md p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="size-4"
            aria-hidden="true"
          >
            <path
              d="M5 5l10 10M15 5L5 15"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <div class="relative sm:w-56">
        <select
          id="filter-sport"
          aria-label="Filtrar por deporte"
          class="block w-full cursor-pointer appearance-none rounded-xl border border-slate-300 bg-white py-2.5 pl-3.5 pr-10 text-sm text-slate-700 transition focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-100"
        >
          <option value="all">Todos los deportes</option>
        </select>
        <svg
          viewBox="0 0 20 20"
          fill="none"
          class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-slate-400"
          aria-hidden="true"
        >
          <path
            d="M5 7.5l5 5 5-5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
    </div>

    <details class="group mt-3">
      <summary
        class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-lg py-1.5 text-[13px] font-semibold text-slate-600 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 [&::-webkit-details-marker]:hidden"
      >
        Más filtros
        <svg
          viewBox="0 0 20 20"
          fill="none"
          class="size-4 transition-transform group-open:rotate-180"
          aria-hidden="true"
        >
          <path
            d="M5 7.5l5 5 5-5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </summary>
      <div class="mt-2.5 flex flex-col gap-3 sm:flex-row">
        <div class="relative sm:w-56">
          <select
            id="filter-emotion"
            aria-label="Filtrar por emoción"
            class="block w-full cursor-pointer appearance-none rounded-xl border border-slate-300 bg-white py-2.5 pl-3.5 pr-10 text-sm text-slate-700 transition focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-100"
          >
            <option value="all">Todas las emociones</option>
            <option value="calma">😌 Calma</option>
            <option value="feliz">😊 Feliz</option>
            <option value="nervioso">⚡ Nervioso</option>
            <option value="enojado">🔥 Enojado</option>
            <option value="triste">🌧️ Triste</option>
          </select>
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-slate-400"
            aria-hidden="true"
          >
            <path
              d="M5 7.5l5 5 5-5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <div class="relative sm:w-64">
          <select
            id="sort-by"
            aria-label="Ordenar resultados"
            class="block w-full cursor-pointer appearance-none rounded-xl border border-slate-300 bg-white py-2.5 pl-3.5 pr-10 text-sm text-slate-700 transition focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-100"
          >
            <option value="date-desc">Más reciente primero</option>
            <option value="date-asc">Más antiguo primero</option>
            <option value="name-asc">Nombre (A a Z)</option>
            <option value="shooting-desc">Mayor puntaje de tiro</option>
            <option value="climbing-asc">Menor tiempo de escalada</option>
          </select>
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-slate-400"
            aria-hidden="true"
          >
            <path
              d="M5 7.5l5 5 5-5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </details>

    <div
      class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4"
    >
      <p
        id="results-count"
        class="text-sm font-medium text-slate-500"
        aria-live="polite"
      >
        Cargando evaluaciones…
      </p>

      <div
        role="group"
        aria-label="Cambiar vista"
        class="inline-flex gap-0.5 rounded-xl border border-slate-200 bg-slate-50 p-0.5"
      >
        <button
          type="button"
          id="view-cards-btn"
          aria-pressed="true"
          class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-lg bg-white px-3 text-[13px] font-semibold text-blue-600 shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="size-4"
            aria-hidden="true"
          >
            <rect
              x="3"
              y="3"
              width="6"
              height="6"
              rx="1.3"
              stroke="currentColor"
              stroke-width="1.7"></rect>
            <rect
              x="11"
              y="3"
              width="6"
              height="6"
              rx="1.3"
              stroke="currentColor"
              stroke-width="1.7"></rect>
            <rect
              x="3"
              y="11"
              width="6"
              height="6"
              rx="1.3"
              stroke="currentColor"
              stroke-width="1.7"></rect>
            <rect
              x="11"
              y="11"
              width="6"
              height="6"
              rx="1.3"
              stroke="currentColor"
              stroke-width="1.7"></rect>
          </svg>
          Tarjetas
        </button>
        <button
          type="button"
          id="view-table-btn"
          aria-pressed="false"
          class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-lg px-3 text-[13px] font-semibold text-slate-500 transition-colors hover:text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="size-4"
            aria-hidden="true"
          >
            <rect
              x="3"
              y="4"
              width="14"
              height="12"
              rx="2"
              stroke="currentColor"
              stroke-width="1.7"></rect>
            <path d="M3 9h14M8 9v7" stroke="currentColor" stroke-width="1.7"
            ></path>
          </svg>
          Tabla
        </button>
        <button
          type="button"
          id="view-charts-btn"
          aria-pressed="false"
          class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-lg px-3 text-[13px] font-semibold text-slate-500 transition-colors hover:text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="size-4"
            aria-hidden="true"
          >
            <path
              d="M4 16V9m6 7V4m6 12v-4"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
          Gráficos
        </button>
      </div>
    </div>
  </section>

  <!-- ── CARGANDO ── -->
  <div id="loading-state" class="grid gap-5 md:grid-cols-2" aria-hidden="true">
    {
      [0, 1, 2, 3].map(() => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="mb-5 flex items-center gap-3">
            <div class="size-12 rounded-xl bg-slate-100 motion-safe:animate-pulse" />
            <div class="flex-1 space-y-2">
              <div class="h-4 w-2/3 rounded bg-slate-100 motion-safe:animate-pulse" />
              <div class="h-3 w-1/2 rounded bg-slate-100 motion-safe:animate-pulse" />
            </div>
          </div>
          <div class="mb-3 h-20 rounded-xl bg-slate-100 motion-safe:animate-pulse" />
          <div class="h-10 w-44 rounded-xl bg-slate-100 motion-safe:animate-pulse" />
        </div>
      ))
    }
  </div>

  <!-- ── VISTA 1: TARJETAS ── -->
  <div
    id="cards-view"
    class="grid min-w-0 grid-cols-1 gap-5 min-[1100px]:grid-cols-2"
    style="display:none;"
  >
  </div>

  <!-- ── VISTA 2: TABLA ── -->
  <div
    id="table-view"
    class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    style="display:none;"
  >
    <div class="overflow-x-auto">
      <table class="w-full min-w-[880px] border-collapse text-sm">
        <caption class="sr-only">Evaluaciones registradas</caption>
        <thead class="bg-slate-50">
          <tr
            class="border-b border-slate-200 text-left text-[13px] font-semibold text-slate-500"
          >
            <th scope="col" class="whitespace-nowrap px-5 py-3.5">Atleta</th>
            <th scope="col" class="whitespace-nowrap px-5 py-3.5">Deporte</th>
            <th scope="col" class="whitespace-nowrap px-5 py-3.5"
              >Estado emocional</th
            >
            <th scope="col" class="whitespace-nowrap px-5 py-3.5"
              >Tiro (fácil / difícil)</th
            >
            <th scope="col" class="whitespace-nowrap px-5 py-3.5"
              >Escalada (fácil / difícil)</th
            >
            <th scope="col" class="whitespace-nowrap px-5 py-3.5"
              >Emociones post</th
            >
            <th scope="col" class="whitespace-nowrap px-5 py-3.5">Fecha</th>
          </tr>
        </thead>
        <tbody id="table-body" class="divide-y divide-slate-100"></tbody>
      </table>
    </div>
  </div>

  <!-- ── VISTA 3: GRÁFICOS ── -->
  <div id="charts-view" class="grid gap-5 md:grid-cols-2" style="display:none;">
    <section
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
    >
      <h3 class="text-[15px] font-bold text-slate-900">
        Rendimiento y confianza
      </h3>
      <p class="mb-5 mt-0.5 text-xs text-slate-500">
        Escala del 1 al 5 por atleta
      </p>
      <div class="relative h-[280px]">
        <canvas id="chart-performance"></canvas>
      </div>
    </section>
    <section
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
    >
      <h3 class="text-[15px] font-bold text-slate-900">Tiempos de escalada</h3>
      <p class="mb-5 mt-0.5 text-xs text-slate-500">Segundos: menor es mejor</p>
      <div class="relative h-[280px]">
        <canvas id="chart-climbing"></canvas>
      </div>
    </section>
  </div>

  <!-- ── ESTADO VACÍO ── -->
  <div
    id="empty-state"
    class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center"
    style="display:none;"
  >
    <span
      class="mx-auto inline-flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-400"
    >
      <svg viewBox="0 0 20 20" fill="none" class="size-5" aria-hidden="true">
        <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.8"
        ></circle>
        <path
          d="M13.5 13.5L17 17"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path>
      </svg>
    </span>
    <h3 class="mt-4 text-lg font-bold text-slate-800">
      No se encontraron evaluaciones
    </h3>
    <p class="mt-1 text-sm text-slate-500">
      Prueba vinculando una sesión mediante su código de 8 dígitos o limpiando
      los filtros.
    </p>
    <button
      type="button"
      id="btn-reset-filters"
      class="mt-5 inline-flex h-10 cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
    >
      Limpiar filtros
    </button>
  </div>

  <!-- ── MODAL ESTÉTICO: VINCULAR SESIÓN POR CÓDIGO ── -->
  <dialog
    id="modal-vincular"
    class="fixed inset-0 m-auto w-[min(92vw,28rem)] rounded-2xl bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm"
  >
    <div class="p-6">
      <div
        class="flex items-center justify-between pb-3 border-b border-slate-100"
      >
        <h3 class="text-base font-extrabold text-slate-900">
          Vincular nueva sesión
        </h3>
        <button
          type="button"
          id="btn-cerrar-modal-vincular"
          class="text-slate-400 hover:text-slate-600"
        >
          <svg viewBox="0 0 20 20" fill="none" class="size-5">
            <path
              d="M5 5l10 10M15 5L5 15"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <p class="mt-3 text-sm text-slate-500 leading-relaxed">
        Ingresa los primeros <strong class="text-slate-800">8 dígitos</strong> del
        identificador de sesión (Session ID) para asociarla a tu cuenta.
      </p>

      <div class="mt-4">
        <label
          for="input-id-corto"
          class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5"
          >Código de 8 dígitos</label
        >
        <input
          type="text"
          id="input-id-corto"
          maxlength="8"
          placeholder="Ej: bf4f9865"
          autocomplete="off"
          class="w-full rounded-xl border border-slate-300 bg-slate-50 p-3 font-mono text-center text-lg tracking-widest text-slate-900 outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-100"
        />
      </div>

      <div
        id="modal-vincular-msg"
        class="mt-3 text-center text-xs font-medium"
        style="display:none;"
      >
      </div>

      <div class="mt-6 flex justify-end gap-2.5 border-t border-slate-100 pt-4">
        <button
          type="button"
          id="btn-cancelar-vincular"
          class="inline-flex h-10 cursor-pointer items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
        >
          Cancelar
        </button>
        <button
          type="button"
          id="btn-ejecutar-vincular"
          class="inline-flex h-10 cursor-pointer items-center justify-center rounded-xl bg-indigo-600 px-5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700"
        >
          Vincular sesión
        </button>
      </div>
    </div>
  </dialog>

  <!-- ── MODAL DETALLE DE SESIÓN ── -->
  <dialog
    id="session-modal"
    aria-labelledby="detail-modal-title"
    class="fixed inset-0 m-auto h-[min(860px,calc(100dvh-1.5rem))] max-h-[calc(100dvh-1.5rem)] w-[min(96vw,1280px)] max-w-none overflow-visible bg-transparent p-0 backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm"
  >
    <div
      class="flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-2xl"
    >
      <div
        class="flex items-center justify-between gap-4 border-b border-slate-200 px-5 py-4 sm:px-6"
      >
        <h2
          id="detail-modal-title"
          class="truncate text-base font-bold text-slate-900"
        >
          Detalle de la sesión
        </h2>
        <button
          type="button"
          id="btn-close-modal"
          aria-label="Cerrar detalle"
          class="inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="size-5"
            aria-hidden="true"
          >
            <path
              d="M5 5l10 10M15 5L5 15"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto px-5 py-5 sm:px-6">
        <div id="detail-modal-content"></div>
        <pre
          id="json-modal-content"
          hidden
          class="mt-4 overflow-x-auto whitespace-pre rounded-xl bg-slate-900 p-5 font-mono text-xs leading-7 text-sky-300">
        </pre>
      </div>
    </div>
  </dialog>

  <!-- ── TOAST ── -->
  <div
    id="toast"
    role="status"
    aria-live="polite"
    class="pointer-events-none fixed bottom-6 right-6 z-[9999] translate-y-20 opacity-0 transition duration-300 motion-reduce:transition-none"
  >
    <div
      class="flex items-center gap-2.5 rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white shadow-xl"
    >
      <svg
        viewBox="0 0 20 20"
        fill="none"
        class="size-4 text-emerald-400"
        aria-hidden="true"
      >
        <path
          d="M4.5 10.5l3.5 3.5 7.5-8"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span id="toast-message">Copiado</span>
    </div>
  </div>

  <script>
    import {
      fetchSportmindData,
      filterSportmindRecords,
      getEmotionConfig,
      formatDateTime,
      type SportmindSession,
    } from "../services/sportmindService";
    import { registrarAccionAWS } from "../services/loggerservice";
    import Chart from "chart.js/auto";

    // ── Restricción de Roles y Apertura de Modal ──
    function restringirVistasPorRol() {
      const token = localStorage.getItem("sportmind_token");
      if (!token) return;

      try {
        const payload = JSON.parse(atob(token.split(".")[1]));
        const gruposCrudos =
          payload["cognito:groups"] || payload["groups"] || [];
        const grupos = Array.isArray(gruposCrudos)
          ? gruposCrudos.map((g: string) => g.toLowerCase())
          : [String(gruposCrudos).toLowerCase()];

        // Verificamos si es administrador
        const esAdmin = grupos.some(
          (g) => g.includes("administrador") || g.includes("admin"),
        );

        if (!esAdmin) {
          // Ocultar elementos de administración en la barra lateral
          const enlacesMenu = document.querySelectorAll(
            "aside a, nav a, .sidebar a, a",
          );
          enlacesMenu.forEach((enlace) => {
            const texto = enlace.textContent?.toLowerCase() || "";
            const href = enlace.getAttribute("href") || "";

            if (
              texto.includes("historial de acciones") ||
              texto.includes("crear entrenador") ||
              href.includes("logs") ||
              href.includes("crear")
            ) {
              (enlace as HTMLElement).style.display = "none";
            }
          });

          // Mostrar el botón de vincular sesión para los especialistas
          const btnAbrirModal = document.getElementById(
            "btn-abrir-modal-vincular",
          );
          if (btnAbrirModal) btnAbrirModal.classList.remove("hidden");
        }
      } catch (e) {
        console.error("Error al validar los roles del token:", e);
      }
    }

    // Lógica del Modal Estético de Vincular (LocalStorage)
    const modalVincular = document.getElementById(
      "modal-vincular",
    ) as HTMLDialogElement;
    const btnAbrirModal = document.getElementById("btn-abrir-modal-vincular");
    const btnCerrarModal = document.getElementById("btn-cerrar-modal-vincular");
    const btnCancelarVincular = document.getElementById(
      "btn-cancelar-vincular",
    );
    const btnEjecutarVincular = document.getElementById(
      "btn-ejecutar-vincular",
    ) as HTMLButtonElement;
    const inputIdCorto = document.getElementById(
      "input-id-corto",
    ) as HTMLInputElement;
    const modalMsg = document.getElementById(
      "modal-vincular-msg",
    ) as HTMLElement;

    btnAbrirModal?.addEventListener("click", () => {
      if (inputIdCorto) inputIdCorto.value = "";
      if (modalMsg) modalMsg.style.display = "none";
      modalVincular?.showModal();
    });

    const cerrarModalVincular = () => modalVincular?.close();
    btnCerrarModal?.addEventListener("click", cerrarModalVincular);
    btnCancelarVincular?.addEventListener("click", cerrarModalVincular);

    btnEjecutarVincular?.addEventListener("click", () => {
      const codigo = inputIdCorto.value.trim().toLowerCase();
      if (codigo.length < 8) {
        modalMsg.textContent = "⚠️ Debes ingresar al menos 8 dígitos.";
        modalMsg.className =
          "mt-3 text-center text-xs font-semibold text-amber-600";
        modalMsg.style.display = "block";
        return;
      }

      try {
        const codigosVinculados: string[] = JSON.parse(
          localStorage.getItem("sportmind_linked_codes") || "[]",
        );

        if (!codigosVinculados.includes(codigo)) {
          codigosVinculados.push(codigo);
          localStorage.setItem(
            "sportmind_linked_codes",
            JSON.stringify(codigosVinculados),
          );
        }

        modalMsg.textContent = "✅ ¡Sesión vinculada con éxito!";
        modalMsg.className =
          "mt-3 text-center text-xs font-semibold text-emerald-600";
        modalMsg.style.display = "block";

        setTimeout(() => {
          modalVincular.close();
          window.location.reload();
        }, 800);
      } catch (err: any) {
        modalMsg.textContent = "❌ Error al guardar localmente.";
        modalMsg.className =
          "mt-3 text-center text-xs font-semibold text-red-600";
        modalMsg.style.display = "block";
      }
    });

    // ── Logging ──
    function obtenerUsuarioActual(): string {
      const token = localStorage.getItem("sportmind_token");
      if (token) {
        try {
          const payload = JSON.parse(atob(token.split(".")[1]));
          return (
            payload.name ||
            payload.given_name ||
            payload.email ||
            payload["cognito:username"] ||
            "Especialista"
          );
        } catch (e) {
          console.error("Error al leer el token para el log:", e);
        }
      }
      return localStorage.getItem("sportmind_user") || "Usuario";
    }

    function registrarEventoLog(
      accion: string,
      nivel: "INFO" | "WARN" | "ERROR" = "INFO",
    ) {
      registrarAccionAWS(accion, nivel).catch((err) =>
        console.error("Error al registrar acción en AWS:", err),
      );
    }

    let allSessions: SportmindSession[] = [];
    let currentFiltered: SportmindSession[] = [];
    let currentView: "cards" | "table" | "charts" = "cards";
    let chartPerformanceInstance: Chart | null = null;
    let chartClimbingInstance: Chart | null = null;

    const VIEW_ACTIVE = ["bg-white", "text-blue-600", "shadow-sm"];
    const VIEW_INACTIVE = ["text-slate-500", "hover:text-slate-800"];
    const BTN_SECONDARY =
      "inline-flex h-9 cursor-pointer items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3.5 text-[13px] font-semibold text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60";
    const IA_PANEL_BASE = "ia-result-panel min-h-[130px] rounded-xl border p-4";
    const IA_PANEL_TONE = {
      idle: "border-slate-200 bg-white",
      ok: "border-emerald-200 bg-emerald-50",
      risk: "border-amber-200 bg-amber-50",
    };
    const EMOTION_TONES: Record<string, { badge: string; dot: string }> = {
      emerald: {
        badge: "bg-emerald-50 text-emerald-700 ring-emerald-200",
        dot: "bg-emerald-500",
      },
      cyan: {
        badge: "bg-cyan-50 text-cyan-700 ring-cyan-200",
        dot: "bg-cyan-500",
      },
      amber: {
        badge: "bg-amber-50 text-amber-700 ring-amber-200",
        dot: "bg-amber-500",
      },
      purple: {
        badge: "bg-purple-50 text-purple-700 ring-purple-200",
        dot: "bg-purple-500",
      },
      rose: {
        badge: "bg-rose-50 text-rose-700 ring-rose-200",
        dot: "bg-rose-500",
      },
      neutral: {
        badge: "bg-slate-50 text-slate-600 ring-slate-200",
        dot: "bg-slate-400",
      },
    };
    let toastTimer: ReturnType<typeof setTimeout> | undefined;

    const ICON_CHEVRON = `<svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true"><path d="M8 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    const ICON_COPY = `<svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true"><rect x="7" y="7" width="9" height="9" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4h-6A1.5 1.5 0 0 0 4 5.5v6A1.5 1.5 0 0 0 5.5 13H7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`;
    const ICON_PDF = `<svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true"><path d="M10 3.5v9m0 0l-3.5-3.5M10 12.5L13.5 9M4 15.5h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    const ICON_SPARK = `<svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true"><path d="M10 3l1.6 4.4L16 9l-4.4 1.6L10 15l-1.6-4.4L4 9l4.4-1.6L10 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`;
    const ICON_OK = `<svg viewBox="0 0 20 20" fill="none" class="size-5 shrink-0" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.7"/><path d="M6.8 10.3l2.2 2.2 4.2-4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    const ICON_WARN = `<svg viewBox="0 0 20 20" fill="none" class="size-5 shrink-0" aria-hidden="true"><path d="M10 3.5l7 12.2H3L10 3.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M10 8.5v3.2M10 13.9v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`;

    const escapeHtml = (value: unknown) =>
      String(value ?? "").replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c] as string,
      );

    function emotionTone(badgeClass?: string) {
      const source = badgeClass || "";
      const key = Object.keys(EMOTION_TONES).find(
        (k) => k !== "neutral" && source.includes(k),
      );
      return EMOTION_TONES[key ?? "neutral"];
    }

    function emotionBadge(em: ReturnType<typeof getEmotionConfig>): string {
      const tone = emotionTone(em.badgeClass);
      return `<span class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset ${tone.badge}"><span class="size-1.5 rounded-full ${tone.dot}" aria-hidden="true"></span>${em.icon} ${em.label}</span>`;
    }

    const highlightChip = (label: string, value: string) =>
      `<span class="session-highlight inline-flex items-baseline gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600">${label} <strong class="text-[13px] font-bold tabular-nums text-slate-900">${value}</strong></span>`;

    const iaMessage = (title: string, text: string) =>
      `<div class="ia-diagnosis-label text-xs font-semibold text-slate-500">${title}</div><div class="ia-confidence mt-1.5 text-[13px] leading-relaxed text-slate-600">${text}</div>`;

    const loadingState = document.getElementById("loading-state");
    const cardsView = document.getElementById("cards-view");
    const tableView = document.getElementById("table-view");
    const chartsView = document.getElementById("charts-view");
    const tableBody = document.getElementById("table-body");
    const emptyState = document.getElementById("empty-state");
    const resultsCount = document.getElementById("results-count");
    const sourcesCount = document.getElementById("sources-count");
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const btnClearSearch = document.getElementById(
      "btn-clear-search",
    ) as HTMLButtonElement;
    const filterSport = document.getElementById(
      "filter-sport",
    ) as HTMLSelectElement;
    const filterEmotion = document.getElementById(
      "filter-emotion",
    ) as HTMLSelectElement;
    const sortBy = document.getElementById("sort-by") as HTMLSelectElement;
    const viewCardsBtn = document.getElementById("view-cards-btn");
    const viewTableBtn = document.getElementById("view-table-btn");
    const viewChartsBtn = document.getElementById("view-charts-btn");
    const btnRefresh = document.getElementById("btn-refresh-s3");
    const jsonModal = document.getElementById(
      "session-modal",
    ) as HTMLDialogElement;
    const detailModalTitle = document.getElementById("detail-modal-title");
    const detailModalContent = document.getElementById("detail-modal-content");
    const jsonModalContent = document.getElementById("json-modal-content");
    const btnCloseModal = document.getElementById("btn-close-modal");

    function showToast(msg: string) {
      const toast = document.getElementById("toast");
      const toastMsg = document.getElementById("toast-message");
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove("translate-y-20", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-20", "opacity-0");
      }, 2800);
    }

    function getInitials(name?: string): string {
      if (!name) return "??";
      const parts = name.trim().split(/\s+/);
      if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
      return (parts[0][0] + parts[1][0]).toUpperCase();
    }

    function formatName(name?: string): string {
      if (!name) return "Atleta sin nombre";
      return name
        .toLowerCase()
        .split(" ")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" ");
    }

    function renderMeter(
      label: string,
      val: number | undefined,
      max = 5,
    ): string {
      if (typeof val !== "number" || !Number.isFinite(val)) return "";
      const v = val;
      const pct = Math.min(Math.max((v / max) * 100, 0), 100);
      const tone =
        v >= 4
          ? "bg-emerald-500"
          : v >= 3
            ? "bg-blue-500"
            : v >= 2
              ? "bg-amber-500"
              : "bg-red-500";
      return `
        <div class="mt-2.5">
          <div class="flex items-baseline justify-between">
            <span class="meter-label text-xs font-semibold text-slate-600">${label}</span>
            <span class="meter-val text-xs font-bold tabular-nums text-slate-900">${v}/${max}</span>
          </div>
          <div class="meter-track mt-1.5 h-1.5 overflow-hidden rounded-full bg-slate-200" role="meter" aria-label="${label}" aria-valuemin="0" aria-valuemax="${max}" aria-valuenow="${v}">
            <div class="meter-fill h-full rounded-full ${tone} transition-[width] duration-500" style="width:${pct}%;"></div>
          </div>
        </div>`;
    }

    async function loadData() {
      if (loadingState) loadingState.style.display = "grid";
      if (cardsView) cardsView.style.display = "none";
      if (tableView) tableView.style.display = "none";
      if (chartsView) chartsView.style.display = "none";
      if (emptyState) emptyState.style.display = "none";

      const btnSvg = btnRefresh?.querySelector("svg");
      btnSvg?.classList.add("animate-spin");

      try {
        allSessions = await fetchSportmindData();
        populateSportFilter(allSessions);
        updateKPIs(allSessions);
        applyFilters();
        if (sourcesCount)
          sourcesCount.textContent = `${allSessions.length} registros en la nube`;
      } catch (err) {
        console.error("Error al cargar datos:", err);
        if (resultsCount)
          resultsCount.innerHTML = `<span class="text-red-600">No se pudieron cargar los registros desde S3. Pulsa Actualizar para reintentar.</span>`;
      } finally {
        if (loadingState) loadingState.style.display = "none";
        btnSvg?.classList.remove("animate-spin");
      }
    }

    function populateSportFilter(sessions: SportmindSession[]) {
      const sports = new Set<string>();
      sessions.forEach((s) => {
        if (s.data.selectedSport) sports.add(s.data.selectedSport);
      });
      filterSport.innerHTML = `<option value="all">Todos los deportes</option>`;
      sports.forEach((sport) => {
        const opt = document.createElement("option");
        opt.value = sport;
        opt.textContent = sport;
        filterSport.appendChild(opt);
      });
    }

    function updateKPIs(sessions: SportmindSession[]) {
      const total = document.getElementById("kpi-total-sessions");
      const athletes = document.getElementById("kpi-unique-athletes");

      if (total) total.textContent = String(sessions.length);
      const uniqueAthletes = new Set(
        sessions
          .map((s) => (s.data.playerName || "").toLowerCase().trim())
          .filter(Boolean),
      );
      if (athletes) athletes.textContent = String(uniqueAthletes.size);
    }

    function applyFilters() {
      const query = searchInput.value;
      const sport = filterSport.value;
      const emotion = filterEmotion.value;
      const sort = sortBy.value as any;

      btnClearSearch.style.display = query.length > 0 ? "block" : "none";
      currentFiltered = filterSportmindRecords(allSessions, {
        query,
        sport,
        emotion,
        sortBy: sort,
      });
      updateKPIs(currentFiltered);
      if (resultsCount)
        resultsCount.textContent = `Mostrando ${currentFiltered.length} de ${allSessions.length} evaluaciones`;
      renderCurrentView();
    }

    function renderCurrentView() {
      if (currentFiltered.length === 0) {
        cardsView && (cardsView.style.display = "none");
        tableView && (tableView.style.display = "none");
        chartsView && (chartsView.style.display = "none");
        emptyState && (emptyState.style.display = "block");
        return;
      }
      emptyState && (emptyState.style.display = "none");

      if (currentView === "cards") {
        cardsView && (cardsView.style.display = "grid");
        tableView && (tableView.style.display = "none");
        chartsView && (chartsView.style.display = "none");
        renderCards(currentFiltered);
      } else if (currentView === "table") {
        cardsView && (cardsView.style.display = "none");
        tableView && (tableView.style.display = "block");
        chartsView && (chartsView.style.display = "none");
        renderTable(currentFiltered);
      } else {
        cardsView && (cardsView.style.display = "none");
        tableView && (tableView.style.display = "none");
        chartsView && (chartsView.style.display = "grid");
        renderCharts(currentFiltered);
      }
    }

    function renderCards(sessions: SportmindSession[]) {
      if (!cardsView) return;
      cardsView.innerHTML = sessions
        .map((session, index) => {
          const d = session.data;
          const em = getEmotionConfig(d.emotionalState);
          const shootPost = getEmotionConfig(d.shootingPostEmotion);
          const climbPost = getEmotionConfig(d.climbingPostEmotion);
          const name = escapeHtml(formatName(d.playerName));
          const initials = escapeHtml(getInitials(d.playerName));
          const sport = escapeHtml(d.selectedSport || "Deporte");
          const gender = escapeHtml(d.gender || "N/A");
          const date = formatDateTime(session.timestamp);
          const climbEasy =
            typeof d.climbingTimeEasy === "number"
              ? d.climbingTimeEasy.toFixed(1)
              : "—";
          const climbHard =
            typeof d.climbingTimeHard === "number"
              ? d.climbingTimeHard.toFixed(1)
              : "—";
          const shootingSummary =
            typeof d.shootingScoreEasy === "number" ||
            typeof d.shootingScoreHard === "number"
              ? highlightChip(
                  "Tiro",
                  `${d.shootingScoreEasy ?? "—"} / ${d.shootingScoreHard ?? "—"} pts`,
                )
              : "";
          const climbingSummary =
            typeof d.climbingTimeEasy === "number" ||
            typeof d.climbingTimeHard === "number"
              ? highlightChip("Escalada", `${climbEasy} / ${climbHard} s`)
              : "";
          const hasShootingData =
            [
              d.shootingScoreEasy,
              d.shootingScoreHard,
              d.shootingRendimiento,
              d.shootingRitmo,
              d.shootingConfianza,
            ].some((value) => typeof value === "number") ||
            Boolean(d.shootingPostEmotion);
          const hasClimbingData =
            [
              d.climbingTimeEasy,
              d.climbingTimeHard,
              d.climbingRendimiento,
              d.climbingRitmo,
              d.climbingConfianza,
            ].some((value) => typeof value === "number") ||
            Boolean(d.climbingPostEmotion);

          const shootingSection = hasShootingData
            ? `
              <div class="metric-section rounded-2xl border border-slate-200 bg-slate-50 p-3.5">
                <div class="metric-section-header mb-3 flex items-center justify-between gap-2">
                  <span class="metric-section-title text-[13px] font-bold text-blue-700">Evaluación de tiro</span>
                  <span class="metric-post-badge rounded-full bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-blue-700 ring-1 ring-inset ring-blue-200">Post: ${shootPost.icon} ${shootPost.label}</span>
                </div>
                <div class="scores-row mb-3 grid grid-cols-2 gap-2">
                  <div class="score-box rounded-xl border border-slate-200 bg-white p-2.5 text-center">
                    <div class="score-label text-xs font-semibold text-slate-500">Fácil</div>
                    <div class="score-value mt-0.5 text-[22px] font-extrabold tabular-nums text-emerald-600">${d.shootingScoreEasy ?? "—"}</div>
                    <div class="score-unit text-[11px] text-slate-500">puntos</div>
                  </div>
                  <div class="score-box rounded-xl border border-slate-200 bg-white p-2.5 text-center">
                    <div class="score-label text-xs font-semibold text-slate-500">Difícil</div>
                    <div class="score-value mt-0.5 text-[22px] font-extrabold tabular-nums text-blue-600">${d.shootingScoreHard ?? "—"}</div>
                    <div class="score-unit text-[11px] text-slate-500">puntos</div>
                  </div>
                </div>
                ${renderMeter("Rendimiento", d.shootingRendimiento)}
                ${renderMeter("Ritmo", d.shootingRitmo)}
                ${renderMeter("Confianza", d.shootingConfianza)}
              </div>`
            : "";

          const climbingSection = hasClimbingData
            ? `
              <div class="metric-section rounded-2xl border border-slate-200 bg-slate-50 p-3.5">
                <div class="metric-section-header mb-3 flex items-center justify-between gap-2">
                  <span class="metric-section-title text-[13px] font-bold text-amber-700">Muro / escalada</span>
                  <span class="metric-post-badge rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700 ring-1 ring-inset ring-amber-200">Post: ${climbPost.icon} ${climbPost.label}</span>
                </div>
                <div class="scores-row mb-3 grid grid-cols-2 gap-2">
                  <div class="score-box rounded-xl border border-slate-200 bg-white p-2.5 text-center">
                    <div class="score-label text-xs font-semibold text-slate-500">T. fácil</div>
                    <div class="score-value mt-0.5 text-[22px] font-extrabold tabular-nums text-amber-600">${climbEasy}</div>
                    <div class="score-unit text-[11px] text-slate-500">segundos</div>
                  </div>
                  <div class="score-box rounded-xl border border-slate-200 bg-white p-2.5 text-center">
                    <div class="score-label text-xs font-semibold text-slate-500">T. difícil</div>
                    <div class="score-value mt-0.5 text-[22px] font-extrabold tabular-nums text-amber-700">${climbHard}</div>
                    <div class="score-unit text-[11px] text-slate-500">segundos</div>
                  </div>
                </div>
                ${renderMeter("Rendimiento", d.climbingRendimiento)}
                ${renderMeter("Ritmo", d.climbingRitmo)}
                ${renderMeter("Confianza", d.climbingConfianza)}
              </div>`
            : "";

          return `
          <article class="eval-card flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-colors hover:border-blue-200 sm:p-6">
            <div class="card-header flex items-start justify-between gap-3 border-b border-slate-100 pb-4">
              <div class="athlete-info flex min-w-0 items-center gap-3">
                <div class="athlete-avatar inline-flex size-12 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-base font-bold text-blue-700" aria-hidden="true">${initials}</div>
                <div class="min-w-0">
                  <h3 class="athlete-name truncate text-base font-extrabold text-slate-900">${name}</h3>
                  <p class="athlete-meta mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-500">
                    <span class="badge-gender rounded-md bg-slate-100 px-2 py-0.5 font-semibold text-slate-600">${gender}</span>
                    <span>${sport}</span>
                    <span class="tabular-nums">${date}</span>
                  </p>
                </div>
              </div>
              ${emotionBadge(em)}
            </div>

            <div class="session-highlights my-4 flex flex-wrap gap-2" aria-label="Resultados registrados">
              ${shootingSummary}${climbingSummary}
              ${!shootingSummary && !climbingSummary ? '<span class="session-highlight rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-500">Sin resultados cuantitativos registrados</span>' : ""}
            </div>

            <div class="mt-auto">
              <button type="button" class="btn-view-details inline-flex h-10 cursor-pointer items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-4 text-[13px] font-semibold text-blue-700 transition-colors hover:bg-blue-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2" data-session-index="${index}" aria-haspopup="dialog">
                Ver informe detallado
                ${ICON_CHEVRON}
              </button>
            </div>

            <template id="session-detail-${index}">
              <div class="card-details-content">
                <div class="detail-layout grid items-start gap-5 min-[860px]:grid-cols-[minmax(260px,0.8fr)_minmax(0,1.7fr)]">
                  <aside class="analysis-column flex min-w-0 flex-col gap-3.5 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:p-5" aria-label="Análisis automatizado">
                    <h3 class="analysis-heading text-[15px] font-extrabold text-slate-900">Análisis de apoyo</h3>
                    <p class="analysis-hint -mt-1.5 text-xs leading-relaxed text-slate-500">La predicción complementa la lectura profesional y no constituye un diagnóstico.</p>
                    <div class="recommendation-chip inline-flex w-fit items-center gap-1.5 rounded-xl border border-blue-200 bg-blue-50 px-3 py-1.5 text-[13px] font-semibold text-blue-700">
                      Recomendación registrada: <strong class="tabular-nums">${d.recomendacionFinal ?? "-"} / 10</strong>
                    </div>
                    <button type="button" class="btn-ai btn-predict-ia inline-flex h-10 w-fit cursor-pointer items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 text-[13px] font-semibold text-white shadow-sm transition-colors hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-70" data-session-index="${index}">
                      ${ICON_SPARK}
                      Analizar sesión
                    </button>
                    <div id="ia-result-${index}" class="${IA_PANEL_BASE} ${IA_PANEL_TONE.idle}">
                      ${iaMessage("Resultado del análisis", 'Pulsa "Analizar sesión" para consultar la predicción y su certeza.')}
                    </div>
                  </aside>

                  <section class="detail-column min-w-0" aria-label="Resultados de la sesión">
                    <div class="metrics-grid grid grid-cols-1 gap-3 sm:grid-cols-2">
                      ${shootingSection}
                      ${climbingSection}
                      ${!hasShootingData && !hasClimbingData ? '<p class="details-no-data text-sm text-slate-500 sm:col-span-2">No hay métricas adicionales registradas para esta sesión.</p>' : ""}
                    </div>

                    <div class="detail-actions mt-4 flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-4">
                      <button type="button" class="btn-json btn-view-raw ${BTN_SECONDARY}" data-session-index="${index}">Ver datos completos</button>
                      <button type="button" class="btn-copy-id ${BTN_SECONDARY}" data-id="${escapeHtml(session.session_id)}" title="Copiar ID de sesión">
                        ${ICON_COPY}
                        Copiar ID
                      </button>
                      <button type="button" class="btn-pdf-atleta ${BTN_SECONDARY}" title="Descargar PDF">
                        ${ICON_PDF}
                        PDF
                      </button>
                    </div>
                  </section>
                </div>
              </div>
            </template>
          </article>`;
        })
        .join("");
      attachCardListeners();
    }

    function renderTable(sessions: SportmindSession[]) {
      if (!tableBody) return;
      tableBody.innerHTML = sessions
        .map((s) => {
          const d = s.data;
          const em = getEmotionConfig(d.emotionalState);
          const sp = getEmotionConfig(d.shootingPostEmotion);
          const cp = getEmotionConfig(d.climbingPostEmotion);
          return `
          <tr class="transition-colors hover:bg-slate-50/70">
            <td class="px-5 py-3.5">
              <div class="flex items-center gap-3">
                <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-xs font-bold text-blue-700" aria-hidden="true">${escapeHtml(getInitials(d.playerName))}</span>
                <div>
                  <div class="font-semibold text-slate-900">${escapeHtml(formatName(d.playerName))}</div>
                  <div class="text-xs text-slate-500">${escapeHtml(d.gender || "")}</div>
                </div>
              </div>
            </td>
            <td class="px-5 py-3.5 font-medium text-slate-700">${escapeHtml(d.selectedSport || "—")}</td>
            <td class="px-5 py-3.5">${emotionBadge(em)}</td>
            <td class="whitespace-nowrap px-5 py-3.5 tabular-nums">
              <span class="font-bold text-emerald-600">${d.shootingScoreEasy ?? "—"} pts</span>
              <span class="text-slate-300">/</span>
              <span class="font-semibold text-blue-600">${d.shootingScoreHard ?? "—"} pts</span>
            </td>
            <td class="whitespace-nowrap px-5 py-3.5 tabular-nums">
              <span class="font-bold text-amber-600">${d.climbingTimeEasy ? d.climbingTimeEasy.toFixed(1) + " s" : "—"}</span>
              <span class="text-slate-300">/</span>
              <span class="font-semibold text-amber-700">${d.climbingTimeHard ? d.climbingTimeHard.toFixed(1) + " s" : "—"}</span>
            </td>
            <td class="whitespace-nowrap px-5 py-3.5">
              <span class="text-lg" title="Tiro: ${sp.label}">${sp.icon}</span>
              <span class="text-lg" title="Escalada: ${cp.label}">${cp.icon}</span>
            </td>
            <td class="whitespace-nowrap px-5 py-3.5 text-xs tabular-nums text-slate-500">${formatDateTime(s.timestamp)}</td>
          </tr>`;
        })
        .join("");
    }

    function renderCharts(sessions: SportmindSession[]) {
      const labels = sessions.map((s) => formatName(s.data.playerName));

      const perfCanvas = document.getElementById(
        "chart-performance",
      ) as HTMLCanvasElement;
      if (perfCanvas) {
        if (chartPerformanceInstance) chartPerformanceInstance.destroy();
        chartPerformanceInstance = new Chart(perfCanvas, {
          type: "bar",
          data: {
            labels,
            datasets: [
              {
                label: "Rendimiento Tiro",
                data: sessions.map((s) => s.data.shootingRendimiento ?? 0),
                backgroundColor: "rgba(59,130,246,0.75)",
                borderRadius: 6,
              },
              {
                label: "Confianza Tiro",
                data: sessions.map((s) => s.data.shootingConfianza ?? 0),
                backgroundColor: "rgba(139,92,246,0.75)",
                borderRadius: 6,
              },
              {
                label: "Rendimiento Escalada",
                data: sessions.map((s) => s.data.climbingRendimiento ?? 0),
                backgroundColor: "rgba(245,158,11,0.75)",
                borderRadius: 6,
              },
              {
                label: "Confianza Escalada",
                data: sessions.map((s) => s.data.climbingConfianza ?? 0),
                backgroundColor: "rgba(16,185,129,0.75)",
                borderRadius: 6,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                min: 0,
                max: 5,
                ticks: { stepSize: 1, color: "#718096" },
                grid: { color: "rgba(0,0,0,0.05)" },
              },
              x: { ticks: { color: "#718096" }, grid: { display: false } },
            },
            plugins: {
              legend: {
                labels: {
                  color: "#4a5568",
                  boxWidth: 13,
                  font: { size: 12, weight: 600 },
                },
              },
            },
          },
        });
      }

      const climbCanvas = document.getElementById(
        "chart-climbing",
      ) as HTMLCanvasElement;
      if (climbCanvas) {
        if (chartClimbingInstance) chartClimbingInstance.destroy();
        chartClimbingInstance = new Chart(climbCanvas, {
          type: "bar",
          data: {
            labels,
            datasets: [
              {
                label: "Tiempo Fácil (s)",
                data: sessions.map((s) => s.data.climbingTimeEasy ?? 0),
                backgroundColor: "rgba(56,189,248,0.75)",
                borderRadius: 6,
              },
              {
                label: "Tiempo Difícil (s)",
                data: sessions.map((s) => s.data.climbingTimeHard ?? 0),
                backgroundColor: "rgba(251,146,60,0.75)",
                borderRadius: 6,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                ticks: { color: "#718096" },
                grid: { color: "rgba(0,0,0,0.05)" },
              },
              x: { ticks: { color: "#718096" }, grid: { display: false } },
            },
            plugins: {
              legend: {
                labels: {
                  color: "#4a5568",
                  boxWidth: 13,
                  font: { size: 12, weight: 600 },
                },
              },
            },
          },
        });
      }
    }

    function attachCardListeners() {
      document.querySelectorAll(".btn-view-details").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const index = Number(
            (e.currentTarget as HTMLElement).dataset.sessionIndex,
          );
          const template = document.getElementById(
            `session-detail-${index}`,
          ) as HTMLTemplateElement | null;
          if (
            !template ||
            !detailModalContent ||
            !jsonModal ||
            !jsonModalContent
          )
            return;
          detailModalContent.replaceChildren(template.content.cloneNode(true));
          jsonModalContent.hidden = true;
          jsonModalContent.textContent = "";
          const session = currentFiltered[index];
          if (detailModalTitle && session) {
            detailModalTitle.textContent = `Informe de ${formatName(session.data.playerName)} · ${session.data.selectedSport || "Sesión"}`;
          }
          jsonModal.showModal();
          registrarEventoLog(
            `Abrió el detalle de la sesión de evaluación del atleta: ${formatName(session?.data?.playerName)}`,
          );
        });
      });
    }

    detailModalContent?.addEventListener("click", async (e) => {
      const target = (e.target as HTMLElement).closest(
        "button",
      ) as HTMLButtonElement | null;
      if (!target) return;

      if (target.classList.contains("btn-copy-id")) {
        const id = target.dataset.id || "";
        await navigator.clipboard.writeText(id);
        showToast(`ID copiado: ${id.substring(0, 8)}…`);
        return;
      }

      const index = Number(target.dataset.sessionIndex);
      const session = currentFiltered[index];
      if (
        target.classList.contains("btn-view-raw") &&
        session &&
        jsonModalContent
      ) {
        jsonModalContent.textContent = JSON.stringify(session, null, 2);
        jsonModalContent.hidden = !jsonModalContent.hidden;
        target.textContent = jsonModalContent.hidden
          ? "Ver datos completos"
          : "Ocultar datos";
        if (!jsonModalContent.hidden)
          jsonModalContent.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
          });
        registrarEventoLog(
          `Consultó los datos completos (JSON) de la sesión del atleta: ${formatName(session?.data?.playerName)}`,
        );
        return;
      }

      if (target.classList.contains("btn-predict-ia") && session) {
        const resultPanel = detailModalContent.querySelector(
          `#ia-result-${index}`,
        );
        if (!resultPanel) return;
        const original = target.innerHTML;
        target.textContent = "Analizando…";
        target.disabled = true;
        resultPanel.className = `${IA_PANEL_BASE} ${IA_PANEL_TONE.idle}`;
        resultPanel.innerHTML = iaMessage(
          "Análisis en curso",
          "Estamos procesando los datos de esta sesión…",
        );

        const iaResponse = await import("../services/analisisIA")
          .then(({ analizarSesion }) => analizarSesion(session.data))
          .catch((error) => {
            console.error("No fue posible cargar el módulo de IA.", error);
            return null;
          });

        target.innerHTML = original;
        target.disabled = false;

        if (iaResponse?.estado === "ok") {
          const isOk = iaResponse.prediccion === 1;
          const prob = iaResponse.probabilidades
            ? (Math.max(...iaResponse.probabilidades) * 100).toFixed(1) + "%"
            : "No disponible";
          const esConducta = iaResponse.modelo === "conducta";
          const notaModelo = esConducta
            ? "Modelo: conducta en RV (puntajes de tiro y tiempos de escalada)."
            : "Se usó el modelo anterior porque el modelo de conducta no está disponible.";
          resultPanel.className = `${IA_PANEL_BASE} ${IA_PANEL_TONE[isOk ? "ok" : "risk"]}`;
          resultPanel.innerHTML = `
            <div class="ia-diagnosis-label text-xs font-semibold text-slate-500">Resultado del análisis automatizado</div>
            <div class="ia-diagnosis-title ${isOk ? "ok text-emerald-700" : "risk text-amber-700"} mt-1.5 flex items-center gap-2 text-[17px] font-extrabold">${isOk ? ICON_OK : ICON_WARN}<span>${escapeHtml(iaResponse.etiqueta)}</span></div>
            <div class="ia-confidence mt-2 text-[13px] text-slate-600">Certeza informada por el modelo: <strong class="text-slate-900">${prob}</strong></div>
            <div class="ia-confidence mt-1 text-xs ${esConducta ? "text-slate-500" : "font-semibold text-amber-700"}">${notaModelo}</div>
            <div class="ia-confidence mt-1 text-xs text-slate-500">Resultado de apoyo; no reemplaza la evaluación profesional.</div>
          `;
          registrarEventoLog(
            `Ejecutó el análisis de IA (${iaResponse.modelo}) para la sesión del atleta: ${formatName(session.data.playerName)}`,
          );
        } else if (iaResponse?.estado === "insuficiente") {
          resultPanel.className = `${IA_PANEL_BASE} ${IA_PANEL_TONE.idle}`;
          resultPanel.innerHTML = iaMessage(
            "Datos insuficientes para analizar",
            escapeHtml(iaResponse.motivo),
          );
        } else {
          resultPanel.className = `${IA_PANEL_BASE} ${IA_PANEL_TONE.idle}`;
          resultPanel.innerHTML = iaMessage(
            "Análisis no disponible",
            "No se pudo cargar el modelo localmente. Revisa la consola para más detalles.",
          );
          showToast("No se pudo iniciar el análisis automatizado.");
        }
      }
    });

    async function loadDataSilencioso() {
      try {
        const nuevosDatos = await fetchSportmindData();
        if (nuevosDatos.length !== allSessions.length) {
          allSessions = nuevosDatos;
          populateSportFilter(allSessions);
          updateKPIs(allSessions);
          applyFilters();
          if (sourcesCount)
            sourcesCount.textContent = `${allSessions.length} registros en la nube`;
          showToast("Datos actualizados desde S3");
        }
      } catch (err) {
        console.error("Error en sincronización automática:", err);
      }
    }

    function setView(view: "cards" | "table" | "charts") {
      currentView = view;
      const order = ["cards", "table", "charts"];
      [viewCardsBtn, viewTableBtn, viewChartsBtn].forEach((btn, i) => {
        if (!btn) return;
        const active = order[i] === view;
        btn.classList.remove(...(active ? VIEW_INACTIVE : VIEW_ACTIVE));
        btn.classList.add(...(active ? VIEW_ACTIVE : VIEW_INACTIVE));
        btn.setAttribute("aria-pressed", String(active));
      });
      renderCurrentView();
    }

    searchInput?.addEventListener("input", applyFilters);
    filterSport?.addEventListener("change", applyFilters);
    filterEmotion?.addEventListener("change", applyFilters);
    sortBy?.addEventListener("change", applyFilters);

    btnClearSearch?.addEventListener("click", () => {
      searchInput.value = "";
      applyFilters();
    });

    document
      .getElementById("btn-reset-filters")
      ?.addEventListener("click", () => {
        searchInput.value = "";
        filterSport.value = "all";
        filterEmotion.value = "all";
        sortBy.value = "date-desc";
        applyFilters();
      });

    viewCardsBtn?.addEventListener("click", () => {
      registrarEventoLog("Cambió a la vista de Tarjetas");
      setView("cards");
    });
    viewTableBtn?.addEventListener("click", () => {
      registrarEventoLog("Cambió a la vista de Tabla");
      setView("table");
    });
    viewChartsBtn?.addEventListener("click", () => {
      registrarEventoLog("Cambió a la vista de Gráficos");
      setView("charts");
    });
    btnRefresh?.addEventListener("click", () => {
      registrarEventoLog("Actualizó datos de sesiones desde S3");
      loadData();
    });
    btnCloseModal?.addEventListener("click", () => jsonModal?.close());
    jsonModal?.addEventListener("click", (e) => {
      if (e.target === jsonModal) jsonModal.close();
    });

    restringirVistasPorRol();
    loadData();
    setInterval(() => {
      loadDataSilencioso();
    }, 15000);
  </script>
  <script>
    import { inicializarGeneradorPdf } from "../services/generadorpdf";

    inicializarGeneradorPdf();
  </script>
</Layout>
