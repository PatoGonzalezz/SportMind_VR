---
import "../styles/global.css";

// Clases base de cada enlace de la barra lateral (Tailwind).
const navBase =
  "nav-link group flex items-center justify-center gap-3 rounded-xl px-0 py-2.5 text-sm font-medium leading-snug text-slate-400 transition-colors hover:bg-white/5 hover:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 md:justify-start md:px-3";

const navItems = [
  {
    href: "/inicio",
    id: "nav-inicio",
    label: "Inicio",
    adminOnly: false,
    icon: `<path d="M3.5 9.5L10 4l6.5 5.5V16a1 1 0 0 1-1 1H12v-4.5H8V17H4.5a1 1 0 0 1-1-1V9.5z" />`,
  },
  {
    href: "/dashboard",
    id: "nav-dashboard",
    label: "Evaluaciones",
    adminOnly: false,
    icon: `<path d="M4 16V9m6 7V4m6 12v-5" />`,
  },
  {
    href: "/usuarios",
    id: "nav-usuarios",
    label: "Usuarios",
    adminOnly: true,
    icon: `<circle cx="7.5" cy="7.5" r="2.7" /><path d="M2.5 16c.5-2.8 2.5-4.2 5-4.2s4.5 1.4 5 4.2" /><circle cx="14" cy="8" r="2.2" /><path d="M14.5 11.9c2 .2 3.4 1.5 3.8 3.6" />`,
  },
  {
    href: "/logs",
    id: "nav-logs",
    label: "Historial de acciones",
    adminOnly: true,
    icon: `<rect x="4.5" y="4" width="11" height="13" rx="2" /><path d="M8 4V3h4v1M7.5 9h5M7.5 12.5h5" />`,
  },
  {
    href: "/especialista/crear",
    id: "nav-crear",
    label: "Crear entrenador/profesional",
    adminOnly: true,
    icon: `<circle cx="8" cy="7" r="3" /><path d="M2.5 17c.6-3 2.8-4.5 5.5-4.5s4.9 1.5 5.5 4.5M16 6v5M13.5 8.5h5" />`,
  },
  {
    href: "/ajustes",
    id: "nav-ajustes",
    label: "Ajustes de cuenta",
    adminOnly: false,
    icon: `<path d="M3 6h8m4 0h2M3 14h2m4 0h8" /><circle cx="13" cy="6" r="2" /><circle cx="7" cy="14" r="2" />`,
  },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-sportmind.png" />
    <title>SportMind – Plataforma de Análisis Deportivo</title>

    <!--
      Únicas reglas CSS globales: Tailwind no puede expresarlas porque
      afectan a elementos que viven en las páginas hijas (clase .admin-only)
      y al <body> antes de verificar la sesión.
    -->
    <style is:global>
      /* Ocultar hasta verificar sesión y roles */
      html:not(.auth-ok) body {
        display: none !important;
      }

      /* Ocultar elementos de administración por defecto para evitar parpadeos */
      html:not(.is-admin) .admin-only {
        display: none !important;
      }
    </style>

    <script is:inline>
      const token = localStorage.getItem("sportmind_token");
      if (!token) {
        window.location.replace("/login");
      } else {
        try {
          const payload = JSON.parse(atob(token.split(".")[1]));
          const grupos = payload["cognito:groups"] || payload["groups"] || [];
          const esAdmin = Array.isArray(grupos)
            ? grupos.some((g) => String(g).toLowerCase().includes("admin"))
            : String(grupos).toLowerCase().includes("admin");

          document.documentElement.classList.add("auth-ok");
          if (esAdmin) {
            document.documentElement.classList.add("is-admin");
          }

          const path = window.location.pathname;
          if (
            !esAdmin &&
            (path.includes("/logs") || path.includes("/especialista/crear"))
          ) {
            window.location.replace("/dashboard");
          }
        } catch (e) {
          localStorage.removeItem("sportmind_token");
          window.location.replace("/login");
        }
      }
    </script>
  </head>

  <body
    class="!flex !flex-row h-screen h-dvh overflow-hidden bg-slate-100 text-slate-900 antialiased"
  >
    <a
      href="#main-content"
      class="sr-only z-[100] rounded-lg bg-white px-4 py-2 text-sm font-semibold text-blue-700 shadow-lg focus:not-sr-only focus:absolute focus:left-3 focus:top-3"
    >
      Saltar al contenido
    </a>

    <!-- ── Sidebar ── -->
    <aside
      class="sidebar flex w-[72px] shrink-0 flex-col overflow-y-auto border-r border-slate-800 bg-slate-900 px-3 py-6 md:w-64 md:px-4"
    >
      <!-- Marca -->
      <div class="mb-6 flex items-center justify-center border-b border-slate-800 pb-6 md:justify-start md:px-2">
  <img src="/Logo_Sportmind.png" alt="Logo SportMind" class="h-10 w-auto object-contain" />
</div>

      <!-- Navegación -->
      <p class="mb-2 hidden px-3 text-xs font-semibold text-slate-400 md:block">
        Secciones
      </p>
      <nav aria-label="Navegación principal" class="flex flex-1 flex-col gap-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              id={item.id}
              title={item.label}
              class:list={[navBase, item.adminOnly && "admin-only"]}
            >
              <svg
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5 shrink-0"
                aria-hidden="true"
              >
                <Fragment set:html={item.icon} />
              </svg>
              <span class="nav-link-label sr-only md:not-sr-only">
                {item.label}
              </span>
            </a>
          ))
        }
      </nav>

      <!-- Usuario y acciones -->
      <div class="mt-4 border-t border-slate-800 pt-4">
        <div
          class="sidebar-user-info mb-2 flex items-center justify-center gap-3 rounded-xl bg-white/5 p-2.5 md:justify-start"
        >
          <div
            id="sidebar-avatar"
            class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-blue-600 text-[13px] font-bold text-white"
            aria-hidden="true"
          >
            US
          </div>
          <div class="hidden min-w-0 md:block">
            <p
              id="sidebar-username"
              class="truncate text-[13px] font-semibold text-slate-100"
            >
              Cargando…
            </p>
            <p id="sidebar-user-role" class="text-xs text-slate-400">
              Sesión activa
            </p>
          </div>
        </div>

        <button
          type="button"
          id="btn-refresh-s3"
          title="Actualizar datos"
          class="btn-sidebar-action mb-1.5 flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-blue-500/15 px-3 py-2.5 text-[13px] font-semibold text-blue-300 ring-1 ring-inset ring-blue-400/25 transition-colors hover:bg-blue-500/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="size-4 shrink-0"
            aria-hidden="true"
          >
            <path
              d="M4 10a6 6 0 0 1 10.2-4.2L16 7.5M16 3.5v4h-4M16 10a6 6 0 0 1-10.2 4.2L4 12.5M4 16.5v-4h4"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span class="btn-sidebar-label sr-only md:not-sr-only"
            >Actualizar datos</span
          >
        </button>

        <button
          type="button"
          id="logout-btn"
          title="Cerrar sesión"
          class="btn-sidebar-action flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl px-3 py-2.5 text-[13px] font-semibold text-slate-400 transition-colors hover:bg-red-500/10 hover:text-red-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="size-4 shrink-0"
            aria-hidden="true"
          >
            <path
              d="M8 4H5.5A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8M12.5 6.5L16 10l-3.5 3.5M16 10H8.5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span class="btn-sidebar-label sr-only md:not-sr-only"
            >Cerrar sesión</span
          >
        </button>
      </div>
    </aside>

    <!-- ── Contenido principal ── -->
    <main
      id="main-content"
      tabindex="-1"
      class="min-w-0 flex-1 overflow-y-auto bg-slate-100 px-4 py-5 focus:outline-none md:px-9 md:py-8"
    >
      <div class="mx-auto w-full max-w-[1440px]">
        <slot />
      </div>
    </main>

    <!-- ── Banner flotante de Actualización (Electron) ── -->
    <div
      id="update-banner"
      class="fixed bottom-5 right-5 z-[200] hidden max-w-sm rounded-2xl bg-slate-900/95 border border-slate-700/80 p-4 text-white shadow-2xl backdrop-blur-md transition-all duration-300"
    >
      <div class="flex items-start gap-3">
        <div
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-500/20 text-blue-400"
        >
          <svg
            class="h-5 w-5 animate-bounce"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
            ></path>
          </svg>
        </div>
        <div class="flex-1">
          <h4 id="update-title" class="text-sm font-bold text-slate-100">
            Actualización disponible
          </h4>
          <p id="update-desc" class="text-xs text-slate-400 mt-0.5">
            Descargando la última versión en segundo plano...
          </p>

          <div id="action-container" class="mt-3 hidden">
            <button
              id="restart-btn"
              class="w-full rounded-xl bg-blue-600 hover:bg-blue-500 px-3 py-2 text-xs font-semibold text-white shadow-md transition-colors cursor-pointer"
            >
              Reiniciar y actualizar
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Enlace activo según la ruta actual
      const NAV_ACTIVE = ["bg-blue-500/15", "text-blue-200"];
      const NAV_INACTIVE = ["text-slate-400"];

      const path = window.location.pathname;
      document.querySelectorAll(".nav-link").forEach((link) => {
        const href = link.getAttribute("href") || "";
        if (path === href || (path.startsWith(href) && href !== "/")) {
          link.classList.remove(...NAV_INACTIVE);
          link.classList.add(...NAV_ACTIVE);
          link.setAttribute("aria-current", "page");
        }
      });

      // Datos del usuario en la barra lateral
      try {
        const token = localStorage.getItem("sportmind_token");
        if (token) {
          const payload = JSON.parse(atob(token.split(".")[1]));
          const nombre =
            payload.name || payload.given_name || payload.email || "Usuario";

          const grupos = payload["cognito:groups"] || payload["groups"] || [];
          const esAdmin = Array.isArray(grupos)
            ? grupos.some((g: string) => g.toLowerCase().includes("admin"))
            : String(grupos).toLowerCase().includes("admin");

          const rolTexto = esAdmin ? "Administrador" : "Especialista";

          const avatarEl = document.getElementById("sidebar-avatar");
          const usernameEl = document.getElementById("sidebar-username");
          const roleEl = document.getElementById("sidebar-user-role");

          if (avatarEl) {
            avatarEl.textContent = nombre
              .split(" ")
              .filter(Boolean)
              .map((n: string) => n[0])
              .join("")
              .substring(0, 2)
              .toUpperCase();
          }
          if (usernameEl) usernameEl.textContent = nombre;
          if (roleEl) roleEl.textContent = rolTexto;
        }
      } catch (e) {
        console.error("Error al leer el token en layout:", e);
      }

      document.getElementById("logout-btn")?.addEventListener("click", () => {
        localStorage.removeItem("sportmind_token");
        window.location.replace("/login");
      });

      // Lógica de escucha para el sistema de actualizaciones en Electron
      declare global {
        interface Window {
          electronAPI?: {
            isElectron?: boolean;
            onUpdateAvailable?: (callback: () => void) => void;
            onUpdateDownloaded?: (callback: () => void) => void;
            restartApp?: () => void;
          };
        }
      }

      if (window.electronAPI?.isElectron) {
        const banner = document.getElementById("update-banner");
        const title = document.getElementById("update-title");
        const desc = document.getElementById("update-desc");
        const actionContainer = document.getElementById("action-container");
        const restartBtn = document.getElementById("restart-btn");

        window.electronAPI.onUpdateAvailable?.(() => {
          if (banner && title && desc) {
            banner.classList.remove("hidden");
            title.innerText = "Actualización encontrada";
            desc.innerText = "Se está descargando la última versión...";
          }
        });

        window.electronAPI.onUpdateDownloaded?.(() => {
          if (banner && title && desc && actionContainer) {
            banner.classList.remove("hidden");
            title.innerText = "¡Actualización lista!";
            desc.innerText =
              "Los cambios se aplicarán al reiniciar la aplicación.";
            actionContainer.classList.remove("hidden");
          }
        });

        restartBtn?.addEventListener("click", () => {
          window.electronAPI?.restartApp?.();
        });
      }
    </script>
  </body>
</html>
