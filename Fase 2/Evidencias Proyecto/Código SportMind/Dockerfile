FROM node:22-bookworm-slim

WORKDIR /app

# Astro reemplaza import.meta.env durante la compilación. Compose pasa aquí
# las variables desde el .env local, sin copiar ese archivo dentro de la imagen.
ARG AWS_API_URL
ARG PUBLIC_AWS_API_URL
ARG AWS_REGION
ARG AWS_USER_POOL_ID
ARG PUBLIC_AWS_COGNITO_CLIENT_ID
ARG PUBLIC_AWS_COGNITO_DOMAIN
ARG PUBLIC_AWS_BUCKET_NAME
ARG AWS_ESPECIALISTAS_TABLE_NAME
ARG AWS_LOGS_TABLE_NAME
ARG COGNITO_API_URL
ARG PUBLIC_SPORTMIND_METRICAS_API_URL
ARG PUBLIC_VR_METRICAS_API_URL
ARG AWS_USUARIOS_API_URL
ARG PUBLIC_AWS_LOGS_API_URL

ENV AWS_API_URL=${AWS_API_URL} \
    PUBLIC_AWS_API_URL=${PUBLIC_AWS_API_URL} \
    AWS_REGION=${AWS_REGION} \
    AWS_USER_POOL_ID=${AWS_USER_POOL_ID} \
    PUBLIC_AWS_COGNITO_CLIENT_ID=${PUBLIC_AWS_COGNITO_CLIENT_ID} \
    PUBLIC_AWS_COGNITO_DOMAIN=${PUBLIC_AWS_COGNITO_DOMAIN} \
    PUBLIC_AWS_BUCKET_NAME=${PUBLIC_AWS_BUCKET_NAME} \
    AWS_ESPECIALISTAS_TABLE_NAME=${AWS_ESPECIALISTAS_TABLE_NAME} \
    AWS_LOGS_TABLE_NAME=${AWS_LOGS_TABLE_NAME} \
    COGNITO_API_URL=${COGNITO_API_URL} \
    PUBLIC_SPORTMIND_METRICAS_API_URL=${PUBLIC_SPORTMIND_METRICAS_API_URL} \
    PUBLIC_VR_METRICAS_API_URL=${PUBLIC_VR_METRICAS_API_URL} \
    AWS_USUARIOS_API_URL=${AWS_USUARIOS_API_URL} \
    PUBLIC_AWS_LOGS_API_URL=${PUBLIC_AWS_LOGS_API_URL} \
    HOST=0.0.0.0 \
    PORT=4321

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build && npm prune --omit=dev

ENV NODE_ENV=production

EXPOSE 4321

CMD ["node", "./dist/server/entry.mjs"]
